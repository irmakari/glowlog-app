{
  "expo": {
    "name": "GlowLog",
    "slug": "glowlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/glowlog-icon.png",
    "scheme": "glowlogapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.irmakari.glowlog",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F9FF",
        "foregroundImage": "./assets/images/glowlog-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/glowlog-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/glowlog-splash.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#F3F9FF",
          "dark": {
            "backgroundColor": "#F3F9FF"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "GlowLog needs access to your selected photos to add a photo to a skincare product.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
